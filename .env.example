# Persistent storage. Use absolute paths in production.
DATABASE_PATH=/srv/baoshijie/data/baoshijie.sqlite
UPLOAD_DIR=/srv/baoshijie/uploads

# Single administrator account.
ADMIN_USERNAME=owner
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$replace-with-generated-salt$replace-with-generated-hash
SESSION_SECRET=replace-with-at-least-32-random-characters

# PayPal Orders v2. Use sandbox until live approval is complete.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Airwallex PaymentIntent. Use demo until production approval is complete.
AIRWALLEX_ENVIRONMENT=demo
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
